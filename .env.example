# SkyDroid environment — generated automatically by the GitHub workflow.
# For manual runs, create .env with a bcrypt hash of your password:
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#
# then paste the resulting hash below (keep the $ characters as-is).

SKY_HASH=$2a$14$REPLACE_WITH_REAL_BCRYPT_HASH
